# ─────────────────────────────────────────────────────────────
# 이 파일을 복사해서 값을 채워 넣으세요. .env 는 두 곳에 필요합니다.
#   cp .env.example ai-service/.env    # GEMINI_*, PUBLIC_DATA_API_KEY
#   cp .env.example backend/.env       # MEOGEODO_ENCRYPTION_KEY, JWT_SECRET, DB_*
# .env 는 .gitignore 에 등록되어 있어 커밋되지 않습니다.
# ─────────────────────────────────────────────────────────────

# Google AI Studio (Gemini)
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 모델. 무료 티어에서 쓸 수 있는 flash 계열을 기본값으로 둡니다.
LLM_MODEL_ID=gemini-3.5-flash-lite

# 무료 티어 분당 요청 수(RPM) 한도.
# 실제 값은 계정마다 다릅니다. AI Studio 의 Rate limit 페이지에서 확인 후 맞추세요:
#   https://aistudio.google.com/rate-limit
# 한도를 넘기면 429가 나고 같은 분 안에서는 재시도해도 계속 막힙니다.
GEMINI_RPM=10

# 공공데이터포털 통합 인증키 (한국관광공사 + 식약처 영양성분DB)
# 주의: 이미 URL 인코딩된 값(%3D%3D)이므로 재인코딩하지 마세요.
PUBLIC_DATA_API_KEY=

# ── 백엔드용 (backend 실행 시 환경변수로 주입) ──

# 건강정보(질환·알레르기·복용약) 컬럼 암호화 키.
# 개인정보보호법상 건강정보는 민감정보라 저장 시 암호화가 필요합니다.
# 반드시 16/24/32 바이트여야 하며, Base64 로 넣습니다.
#   생성: openssl rand -base64 32
# 이 키를 잃으면 기존 사용자의 건강정보를 복호화할 수 없습니다.
MEOGEODO_ENCRYPTION_KEY=

# JWT 서명 키. 32바이트 이상.
#   생성: openssl rand -base64 48
JWT_SECRET=

# zsh 에서는 따옴표가 필요합니다. & 가 백그라운드 실행으로 해석됩니다.
# DB_URL="jdbc:mysql://localhost:3307/meogeodo?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&rewriteBatchedStatements=true"
# DB_USERNAME=meogeodo
# DB_PASSWORD=meogeodo
# AI_SERVICE_URL=http://localhost:8000
# TAGGING_CHUNK_SIZE=50

# ── 배포용 ──

# 브라우저에서 이 API 를 호출할 수 있는 프론트 출처. 쉼표로 여러 개.
# 스킴·호스트·포트가 정확히 일치해야 합니다 — www 나 http 는 별개 출처입니다.
# 비우면 https://mukeodo.site 만 허용합니다.
# CORS_ALLOWED_ORIGINS=https://mukeodo.site,http://localhost:5173

# Swagger UI 의 Servers 드롭다운에 뜨는 배포 주소.
# 비우면 문서를 연 주소에서 추론합니다.
# PUBLIC_BASE_URL=https://api.mukeodo.site

# API 문서를 감추려면 false. 기본값은 true 입니다.
# SWAGGER_ENABLED=true
